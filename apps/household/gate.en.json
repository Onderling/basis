{
  "household.addItem": {
    "doc": "Add something to a household list (shopping, errands, repairs, the schedule); the rest of the line is the list and the item.",
    "verbs": [
      "add"
    ],
    "examples": [
      "add milk"
    ]
  },
  "household.listOpen": {
    "doc": "Show what is open on a household list.",
    "verbs": [
      "list",
      "show"
    ],
    "examples": [
      "show shopping"
    ]
  },
  "household.markComplete": {
    "doc": "Tick something off a household list (bought, done).",
    "verbs": [
      "done",
      "complete",
      "bought",
      "did",
      "finished"
    ],
    "examples": [
      "bought milk"
    ]
  },
  "household.removeItem": {
    "doc": "Remove something from a household list.",
    "verbs": [
      "remove",
      "delete",
      "cancel",
      "nope"
    ],
    "examples": [
      "remove milk"
    ]
  },
  "household.help": {
    "doc": "Show the commands.",
    "verbs": [
      "help"
    ],
    "examples": [
      "help"
    ]
  },
