{
  "pinboard.postRequest": {
    "doc": "Post something to the noticeboard (an ask, an offer, a loan); the rest of the line is the post.",
    "verbs": [
      "vraag",
      "plaats",
      "leen",
      "bied aan"
    ],
    "dropTrailing": [
      "aan",
      "op",
      "in",
      "voor"
    ],
    "examples": [
      "leen een ladder",
      "vraag een boormachine voor"
    ]
  },
  "pinboard.listMyRequests": {
    "doc": "List the posts you put up.",
    "verbs": [
      "mijn"
    ],
    "examples": [
      "mijn"
    ]
  },
  "pinboard.respondToItem": {
    "doc": "Answer a post (opens a chat with whoever posted it).",
    "verbs": [
      "ik help",
      "help met",
      "reageer op",
      "bied hulp"
    ],
    "examples": [
      "reageer op ladder",
      "help met de boormachine"
    ]
  },
  "pinboard.cancelRequest": {
    "doc": "Withdraw one of your posts.",
    "verbs": [
      "intrekken",
      "annuleer"
    ],
    "examples": [
      "intrekken ladder"
    ]
  },
  "pinboard.markReturned": {
    "doc": "Mark something you lent out as returned.",
    "verbs": [
      "teruggebracht",
      "terug"
    ],
    "examples": [
      "teruggebracht ladder"
    ]
  }
}
