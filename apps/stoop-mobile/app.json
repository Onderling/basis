{
  "expo": {
    "name": "Stoop",
    "slug": "stoop-mobile",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "stoop",
    "android": {
      "package": "org.onderling.stoop",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.CHANGE_WIFI_MULTICAST_STATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.WAKE_LOCK"
      ]
    },
    "ios": {
      "bundleIdentifier": "org.onderling.stoop",
      "supportsTablet": false
    },
    "plugins": [
      "expo-dev-client",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Stoop wil de camera gebruiken om QR-codes te scannen en foto's bij posts te plaatsen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Stoop wil toegang tot je foto's om er een aan een post toe te voegen.",
          "cameraPermission": "Stoop wil de camera gebruiken om een foto bij een post te plaatsen."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Stoop wil je locatie ophalen om afstand-gefilterde posts te tonen."
        }
      ]
    ]
  }
}
