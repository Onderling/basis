# One file per backup target in <box>/data/backup-targets/, e.g. primary.env and secondary.env
# (two providers = redundancy; each repository is encrypted with its own password).
# Any restic backend works — S3-compatible shown. NEVER commit a filled-in copy.
RESTIC_REPOSITORY=s3:https://s3.example.org/onderling-backup
RESTIC_PASSWORD=replace-me-long-random
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me

# A LOCAL target (the box's own disk, outside the bot's data — protects against a broken data folder or a bad update,
# not against losing the box): one file, e.g. local.env, with only these two lines.
#   RESTIC_REPOSITORY=/backup/local/restic
#   RESTIC_PASSWORD=replace-me-long-random
# Changing where backups go later is replacing this file (sftp:…, s3:…, b2:…); nothing else changes.
