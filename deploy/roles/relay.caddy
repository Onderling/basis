${RELAY_DOMAIN} {
	# the box's read-only status page (deploy/box lib.sh write_status_page → data/www, mounted by roles/caddy.yml)
	handle_path /box/* {
		root * /srv/box
		file_server
	}
	# the companion's online /manage interface, when the companion role runs with an owner pubkey
	# (a 502 on this path otherwise — harmless; same shape as deploy/caddy/Caddyfile)
	handle /manage* {
		reverse_proxy companion:8790
	}
	# a person's agenda link (`/feed/<id>.<k>.ics`): the companion's owner (a household bot) puts the sealed file, the
	# companion opens it with the key the link carries. The path IS the key: this site block keeps no access log (no
	# `log` directive) — if one is ever added, `log_skip` must stay in this handle (checked by the companion's tests).
	handle /feed/* {
		log_skip
		reverse_proxy companion:8790
	}
	handle {
		reverse_proxy relay:8787
	}
}
