${RELAY_DOMAIN} {
	# the box's read-only status page (deploy/box lib.sh write_status_page → data/www, mounted by roles/caddy.yml)
	handle_path /box/* {
		root * /srv/box
		file_server
	}
	# the companion's online /manage interface, when the companion role runs with an owner pubkey
	# (a 502 on this path otherwise — harmless; same shape as deploy/caddy/Caddyfile)
	handle /manage* {
		reverse_proxy companion:8790
	}
	# a person's agenda link. The companion's owner (a household bot) puts the sealed file; a link opens it with the key
	# it carries. Two forms, while the companion moves off this box to the household's tablet:
	#   /feed/<node>/<id>.<k>.ics → the RELAY, which forwards it to that node over its live session and holds nothing;
	#   /feed/<id>.<k>.ics        → the companion on this box, which opens it itself (until it moves; then 404).
	# The path IS the key: this site block keeps no access log (no `log` directive) — if one is ever added, `log_skip`
	# must stay in this handle, which covers both forms (checked by the companion's tests).
	handle /feed/* {
		log_skip
		@viaRelay path_regexp ^/feed/[A-Za-z0-9_-]{43}/[^/]+$
		route {
			reverse_proxy @viaRelay relay:8787
			reverse_proxy companion:8790
		}
	}
	handle {
		reverse_proxy relay:8787
	}
}
