# A publish target — copy to deploy/web/targets/<name>.env (gitignored) and fill in. No passwords here:
# the SSH/SFTP key is your own, loaded in ssh-agent.
WEB_URL=https://basis.onderling.org
WEB_HOST=ssh.example.org
WEB_USER=onderling
WEB_PORT=22
WEB_PATH=/www/basis.onderling.org
# rsync needs a shell on the host (most VPS/SSH hosting); sftp works on any SFTP-only web host
WEB_MODE=sftp
