{
  "name": "basis-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "@onderling/* packages + mesh-demo example app",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20.19.0 <21",
    "pnpm": ">=10.33.4"
  },
  "scripts": {
    "test": "npm run test --prefix packages/core && npm run test --prefix packages/react-native && npm run test --prefix packages/relay && npm run test --prefix packages/pod-client && npm run test --prefix packages/integration-tests",
    "test:core": "npm run test --prefix packages/core",
    "test:rn": "npm run test --prefix packages/react-native",
    "test:relay": "npm run test --prefix packages/relay",
    "test:pod-client": "npm run test --prefix packages/pod-client",
    "test:scenarios": "npm run test --prefix packages/integration-tests",
    "test:integration": "node scripts/run-integration.mjs",
    "test:integration:provision": "node scripts/run-integration.mjs --provision",
    "demo": "node examples/mesh-demo/index.js",
    "demo:verify": "node examples/mesh-demo/index.js",
    "relay:start": "npm run start --prefix packages/relay",
    "lint:docs": "node scripts/lint-doc-refs.mjs",
    "lint:ledger": "node scripts/lint-ledger.mjs",
    "lint:ledger:update": "node scripts/lint-ledger.mjs --update",
    "test:ledger": "vitest run scripts/lint-ledger.test.mjs",
    "lint:deps": "node scripts/lint-dep-boundaries.mjs",
    "lint:deps:update": "node scripts/lint-dep-boundaries.mjs --update",
    "test:deps": "vitest run scripts/lint-dep-boundaries.test.mjs",
    "lint:codenames": "node scripts/lint-codenames.mjs",
    "test:codenames": "vitest run scripts/lint-codenames.test.mjs",
    "lint:scope": "node scripts/lint-scope-leaks.mjs",
    "test:scope": "vitest run scripts/lint-scope-leaks.test.mjs",
    "changeset": "npx @changesets/cli",
    "version-packages": "npx @changesets/cli version",
    "release": "pnpm -r publish --access public",
    "readme-fitness": "node scripts/readme-fitness.mjs",
    "api-appendix": "node scripts/api-appendix.mjs",
    "api-fitness": "node scripts/api-fitness.mjs",
    "lint:unreached": "node scripts/lint-unreached-exports.mjs",
    "lint:unreached:update": "node scripts/lint-unreached-exports.mjs --update",
    "lint:stale-params": "node scripts/lint-stale-params.mjs",
    "lint:stale-params:update": "node scripts/lint-stale-params.mjs --update",
    "lint:ungoverned-params": "node scripts/lint-ungoverned-user-params.mjs",
    "lint:retired": "node scripts/lint-retired-modules.mjs",
    "plan-index": "node scripts/gen-plan-index.mjs",
    "plan-index:check": "node scripts/gen-plan-index.mjs --check",
    "guards": "node scripts/guards.mjs",
    "guard-index": "node scripts/guard-index.mjs",
    "guard-status": "node scripts/guard-index.mjs --status",
    "health": "node scripts/health.mjs",
    "check:versions": "npx --yes syncpack@13 list-mismatches",
    "fix:versions": "npx --yes syncpack@13 fix-mismatches",
    "tree:fix": "bash scripts/reconstruct-tree.sh",
    "lint:callskill": "node scripts/lint-callskill-literals.mjs",
    "lint:callskill:update": "node scripts/lint-callskill-literals.mjs --update"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "@babel/traverse": "^7.29.0",
    "@changesets/cli": "^2.27.10",
    "@playwright/test": "^1.60.0",
    "playwright": "^1.60.0"
  },
  "pnpm": {
    "//": "Collapse conflicts a clean install can't otherwise place. CRYPTO libs (@noble/*, @scure/*) are",
    "//2": "deliberately UNIFIED to one version each — one audited crypto version, not two — and .syncpackrc",
    "//3": "enforces they never drift. The rest are transitional and dissolve with the file:->workspace:",
    "//4": "migration (batch 2), which lets pnpm's isolated store hold per-package versions natively.",
    "overrides": {
      "@noble/hashes": "^2.2.0",
      "@scure/bip39": "^2.0.1",
      "ws": "^8.20.0",
      "@react-native-async-storage/async-storage": "^1.24.0",
      "bunyan": "2.0.5"
    }
  }
}
