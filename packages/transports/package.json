{
  "name": "@onderling/transports",
  "version": "0.1.0",
  "description": "Concrete network transports (NknTransport, MqttTransport, RelayTransport, RendezvousTransport) extracted out of @onderling/core. Each extends the core Transport base and lazy-imports its native lib (nkn-sdk / mqtt / ws / WebRTC), so the kernel stays free of concrete-adapter dependencies (de-fats packages/core; guarded by core/test/layering.enforcement.test.js).",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Onderling/basis/tree/master/packages/transports#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Onderling/basis.git",
    "directory": "packages/transports"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src"
  ],
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./mdns": "./src/MdnsTransport.js",
    "./mdns-node": "./src/mdnsNodeBackend.js",
    "./mdns-dnssd": "./src/mdnsDnsSdDiscovery.js",
    "./utils/base64": "./src/utils/base64.js"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@onderling/core": "workspace:^",
    "@onderling/logger": "workspace:^",
    "bonjour-service": "^1.4.4",
    "ws": "^8.20.0",
    "tweetnacl": "^1.0.3"
  },
  "optionalDependencies": {
    "node-datachannel": "^0.32.2",
    "nkn-sdk": "^1.3.6",
    "mqtt": "^5.0.0"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
